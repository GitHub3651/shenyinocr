/* OCRGangYin 唯一正式工业视觉主题。 */

/* 1. 基础 */
QWidget {
    color: #000000;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
    font-size: 16px;
    font-weight: 400;
}

QWidget#MainWindow,
QDialog,
QMessageBox {
    background-color: #E9EEF3;
}

QWidget#widget_mainPanel {
    background-color: #F7F9FB;
}

QToolTip {
    background-color: #21303D;
    color: #FFFFFF;
    border: 1px solid #111A22;
    padding: 5px 8px;
    font-size: 16px;
    font-weight: 400;
}

/* 2. 容器、卡片和滚动区 */
QGroupBox {
    background-color: #F7F9FB;
    border: 1px solid #B8C4CE;
    margin-top: 18px;
    padding: 8px 6px 6px 6px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 7px;
    background-color: #F7F9FB;
    color: #000000;
    font-size: 16px;
    font-weight: 600;
}

QWidget#widget_leftDrawer,
QStackedWidget#stackedWidget_leftDrawer,
QWidget#page_inspectionInfo,
QWidget#page_detectionSettings,
QWidget#page_imageSettings,
QWidget#page_plcSettings,
QWidget#page_softwareSettings {
    background-color: #EEF3F7;
    border: none;
}

QWidget#widget_leftDrawer QGroupBox {
    background-color: #F8FAFC;
}

QWidget#widget_leftDrawer QGroupBox::title {
    background-color: #EEF3F7;
}

QGroupBox#groupBox_currentTemplateSettings,
QGroupBox#groupBox_barcodeCsv,
QGroupBox#groupBox_detectionMode,
QGroupBox#groupBox_imageSaving,
QGroupBox#groupBox_imageAcquisitionAndProcessing,
QGroupBox#groupBox_softwareData,
QFrame#frame_plcTriggerMode,
QFrame#frame_plcConnection,
QFrame#frame_plcProcessParameters {
    background-color: #F8FAFC;
    border: 1px solid #B8C4CE;
    padding: 6px;
}

QGroupBox#groupBox_productionStatistics {
    background: transparent;
    border: none;
    margin-top: 18px;
    padding: 0;
}

QGroupBox#groupBox_totalCount,
QGroupBox#groupBox_ngCount,
QGroupBox#groupBox_detectionDuration,
QGroupBox#groupBox_passRate {
    background-color: #FFFFFF;
    border: 1px solid #C3CDD5;
    margin-top: 16px;
    padding: 5px 4px 4px 4px;
}

QGroupBox#groupBox_totalCount::title,
QGroupBox#groupBox_ngCount::title,
QGroupBox#groupBox_detectionDuration::title,
QGroupBox#groupBox_passRate::title {
    background-color: #FFFFFF;
}

QScrollArea#scrollArea_inspectionInfo,
QScrollArea#scrollArea_detectionSettings,
QScrollArea#scrollArea_imageSettings,
QScrollArea#scrollArea_plcSettings,
QScrollArea#scrollArea_softwareSettings {
    background: transparent;
    border: none;
}

QWidget#scrollAreaWidgetContents_inspectionInfo,
QWidget#widget_detectionSettingsScrollContent,
QWidget#widget_imageSettingsScrollContent,
QWidget#widget_plcSettingsScrollContent,
QWidget#widget_softwareSettingsScrollContent {
    background-color: #EEF3F7;
}

/* 3. 标签 */
QLabel {
    background: transparent;
    color: #000000;
}

QLabel:disabled {
    color: #909DA8;
}

QLabel#label_plcConnectionSection,
QLabel#label_plcProcessParametersSection,
QLabel#label_characterSampleTitle,
QLabel#label_characterExistingTitle,
QLabel#label_currentEditTemplate {
    font-weight: 600;
}

QLabel#label_recognitionText {
    background: transparent;
    color: #1769AA;
    border: none;
    padding: 8px 10px;
    font-size: 20px;
    font-weight: 600;
}

QLabel#label_characterNameError {
    color: #C13F3F;
}

QLabel#label_characterPreviewEmpty {
    color: #909DA8;
}

QLabel#label_characterCropCanvas {
    background-color: #202830;
    border: 1px solid #B8C4CE;
}

QLabel#label_characterSample,
QLabel#label_characterPreviewImage {
    background-color: #FFFFFF;
    border: 1px solid #B8C4CE;
}

QFrame#frame_templateGuide,
QFrame#frame_templateGuide QLabel {
    background: transparent;
    border: none;
    padding: 0;
}

QLabel#label_templateGuideTitle {
    color: #1769AA;
    font-size: 18px;
    font-weight: 600;
}

QLabel#label_templateGuideBody {
    color: #000000;
    font-size: 18px;
    font-weight: 400;
    qproperty-wordWrap: false;
}

/* 4. 普通按钮 */
QPushButton {
    min-height: 38px;
    background-color: #FFFFFF;
    color: #000000;
    border: 1px solid #B8C4CE;
    padding: 5px 12px;
    font-size: 16px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #F4F9FD;
    border-color: #6D9EC4;
}

QPushButton:pressed {
    background-color: #E2EDF5;
    border-color: #0E568E;
}

QPushButton:focus {
    background-color: #F4F9FD;
    border-color: #1769AA;
}

QPushButton:disabled {
    background-color: #EDF1F4;
    color: #909DA8;
    border-color: #D4DDE5;
}

/* 5. 工具按钮 */
QGroupBox#groupBox_mainControls QToolButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FFFFFF, stop:1 #EDF2F6);
    color: #000000;
    border: 1px solid #AEBCC8;
    padding: 8px;
    font-size: 16px;
    font-weight: 600;
}

QGroupBox#groupBox_mainControls QToolButton:hover {
    background: #F6FBFF;
    border-color: #6D9EC4;
}

QGroupBox#groupBox_mainControls QToolButton:pressed {
    background: #DDEAF3;
    border-color: #0E568E;
}

QGroupBox#groupBox_mainControls QToolButton:focus {
    border-color: #1769AA;
}

QGroupBox#groupBox_mainControls QToolButton:disabled {
    background: #EDF1F4;
    color: #909DA8;
    border-color: #D2D9DF;
}

QGroupBox#groupBox_mainControls QToolButton#toolButton_createTemplate[uiState="preview"] {
    background: #F6FBFF;
    color: #1769AA;
    border: 2px solid #8EB7D6;
}

QGroupBox#groupBox_mainControls QToolButton#toolButton_createTemplate[uiState="attention"] {
    background: #EAF3FA;
    color: #1769AA;
    border: 2px solid #1769AA;
}

QGroupBox#groupBox_mainControls QToolButton#toolButton_createTemplate:disabled {
    color: #909DA8;
}

QWidget#widget_leftNavigationRail {
    background-color: #DBE3EA;
    border-right: 1px solid #BDC9D3;
}

QWidget#widget_leftNavigationRail QToolButton {
    background-color: transparent;
    color: #000000;
    border: none;
    padding: 5px 2px;
    font-size: 16px;
    font-weight: 600;
}

QWidget#widget_leftNavigationRail QToolButton:hover {
    background-color: #EAF1F6;
    color: #1769AA;
}

QWidget#widget_leftNavigationRail QToolButton:checked {
    background-color: #F8FAFC;
    color: #1769AA;
}

QSplitter#splitter_leftDrawerMain::handle {
    background: transparent;
    border: none;
}

/* 6. 输入控件 */
QLineEdit,
QTextEdit,
QPlainTextEdit,
QSpinBox,
QDoubleSpinBox,
QDateEdit,
QTimeEdit,
QComboBox {
    min-height: 38px;
    background-color: #FFFFFF;
    color: #000000;
    border: 1px solid #B8C4CE;
    padding: 5px 10px;
    font-size: 16px;
    selection-background-color: #1769AA;
    selection-color: #FFFFFF;
}

QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QDateEdit:hover,
QTimeEdit:hover,
QComboBox:hover {
    border-color: #8EA4B5;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateEdit:focus,
QTimeEdit:focus,
QComboBox:focus {
    background-color: #F4F9FD;
    border-color: #1769AA;
}

QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QDateEdit:disabled,
QTimeEdit:disabled,
QComboBox:disabled {
    background-color: #EDF1F4;
    color: #909DA8;
    border-color: #D4DDE5;
}

QTextEdit#textEdit_targetText {
    font-size: 26px;
    font-weight: 600;
}

QLineEdit[readOnly="true"],
QTextEdit[readOnly="true"],
QPlainTextEdit[readOnly="true"] {
    background-color: #F3F6F8;
    color: #000000;
}

QLineEdit[hasError="true"],
QTextEdit[hasError="true"],
QSpinBox[hasError="true"],
QDoubleSpinBox[hasError="true"] {
    background-color: #FFF1F1;
    border-color: #C13F3F;
}

QComboBox::drop-down {
    width: 28px;
    background-color: transparent;
    border: none;
    border-left: 1px solid #D4DDE5;
}

QComboBox::drop-down:disabled {
    background-color: #E5EAEE;
}

/* 7. 复选框 */
QCheckBox {
    background: transparent;
    color: #000000;
    spacing: 8px;
}

QCheckBox:hover {
    color: #1769AA;
}

QCheckBox:disabled {
    color: #909DA8;
}

QCheckBox::indicator {
    width: 20px;
    height: 20px;
}

/* 8. 列表、树、表格和弹出视图 */
QAbstractItemView {
    background-color: #FFFFFF;
    alternate-background-color: #F7F9FB;
    color: #000000;
    border: 1px solid #B8C4CE;
    selection-background-color: #1769AA;
    selection-color: #FFFFFF;
}

QHeaderView::section {
    background-color: #EEF3F7;
    color: #000000;
    border: none;
    border-right: 1px solid #D4DDE5;
    border-bottom: 1px solid #D4DDE5;
    padding: 6px 8px;
    font-weight: 600;
}

/* 9. 语义角色 */
QPushButton[uiRole="primary"] {
    background-color: #1769AA;
    color: #FFFFFF;
    border-color: #1769AA;
}

QPushButton[uiRole="primary"]:hover {
    background-color: #247CB9;
    border-color: #247CB9;
}

QPushButton[uiRole="primary"]:pressed {
    background-color: #0E568E;
    border-color: #0E568E;
}

QPushButton[uiRole="primary"]:disabled {
    background-color: #A8C7DE;
    color: #FFFFFF;
    border-color: #A8C7DE;
}

QPushButton[uiRole="danger"],
QPushButton#pushButton_clearSoftwareData,
QPushButton#pushButton_resetTotalCount,
QPushButton#pushButton_resetNgCount,
QPushButton#pushButton_resetRejectQueue {
    background-color: #C13F3F;
    color: #FFFFFF;
    border-color: #A93636;
}

QPushButton[uiRole="danger"]:hover,
QPushButton#pushButton_clearSoftwareData:hover,
QPushButton#pushButton_resetTotalCount:hover,
QPushButton#pushButton_resetNgCount:hover,
QPushButton#pushButton_resetRejectQueue:hover {
    background-color: #D14B4B;
    border-color: #B73838;
}

QPushButton[uiRole="danger"]:pressed,
QPushButton#pushButton_clearSoftwareData:pressed,
QPushButton#pushButton_resetTotalCount:pressed,
QPushButton#pushButton_resetNgCount:pressed,
QPushButton#pushButton_resetRejectQueue:pressed {
    background-color: #A93232;
    border-color: #8F2929;
}

QPushButton[uiRole="danger"]:disabled,
QPushButton#pushButton_clearSoftwareData:disabled,
QPushButton#pushButton_resetTotalCount:disabled,
QPushButton#pushButton_resetNgCount:disabled,
QPushButton#pushButton_resetRejectQueue:disabled {
    background-color: #D9B4B4;
    color: #FFFFFF;
    border-color: #D9B4B4;
}

/* 10. 运行状态与判定 */
QLabel#label_runtimeStatus {
    background-color: #EEF1F4;
    color: #000000;
    border: 1px solid #B8C4CE;
    padding: 10px;
    font-size: 26px;
    font-weight: 600;
}

QLabel#label_runtimeStatus[uiState="idle"] {
    background-color: #EEF1F4;
    color: #000000;
    border-color: #C8D1D9;
}

QLabel#label_runtimeStatus[uiState="ready"] {
    background-color: #EAF6EF;
    color: #17834C;
    border-color: #A8D4BC;
}

QLabel#label_runtimeStatus[uiState="running"] {
    background-color: #EAF3FA;
    color: #1769AA;
    border-color: #A8C9E2;
}

QLabel#label_runtimeStatus[uiState="stopping"],
QLabel#label_runtimeStatus[uiState="warning"] {
    background-color: #FFF4E3;
    color: #C98218;
    border-color: #E9CAA0;
}

QLabel#label_runtimeStatus[uiState="fault"] {
    background-color: #FBEAEA;
    color: #C13F3F;
    border-color: #D99A9A;
}

QLabel#label_verdictResult {
    background-color: #202830;
    color: #000000;
    border: none;
    padding: 10px;
    font-size: 56px;
    font-weight: 600;
}

QLabel#label_verdictResult[verdict="idle"] {
    background-color: #202830;
    color: #000000;
    border: none;
}

QLabel#label_verdictResult[verdict="ok"] {
    background-color: #202830;
    color: #17834C;
    border: none;
}

QLabel#label_verdictResult[verdict="ng"] {
    background-color: #202830;
    color: #C13F3F;
    border: none;
}

QLabel#label_verdictResult[verdict="fault"] {
    background-color: #8F2E2E;
    color: #FFFFFF;
    border: 1px solid #8F2E2E;
    font-size: 26px;
}

/* 11. 页面滚动条，仅限定左侧五页 */
QScrollArea#scrollArea_inspectionInfo QScrollBar:vertical,
QScrollArea#scrollArea_detectionSettings QScrollBar:vertical,
QScrollArea#scrollArea_imageSettings QScrollBar:vertical,
QScrollArea#scrollArea_plcSettings QScrollBar:vertical,
QScrollArea#scrollArea_softwareSettings QScrollBar:vertical {
    width: 8px;
    background: transparent;
    margin: 0;
}

QScrollArea#scrollArea_inspectionInfo QScrollBar::handle:vertical,
QScrollArea#scrollArea_detectionSettings QScrollBar::handle:vertical,
QScrollArea#scrollArea_imageSettings QScrollBar::handle:vertical,
QScrollArea#scrollArea_plcSettings QScrollBar::handle:vertical,
QScrollArea#scrollArea_softwareSettings QScrollBar::handle:vertical {
    min-height: 28px;
    background-color: #B9C6D1;
}

QScrollArea#scrollArea_inspectionInfo QScrollBar::handle:vertical:hover,
QScrollArea#scrollArea_detectionSettings QScrollBar::handle:vertical:hover,
QScrollArea#scrollArea_imageSettings QScrollBar::handle:vertical:hover,
QScrollArea#scrollArea_plcSettings QScrollBar::handle:vertical:hover,
QScrollArea#scrollArea_softwareSettings QScrollBar::handle:vertical:hover {
    background-color: #8EA4B5;
}

QScrollArea#scrollArea_inspectionInfo QScrollBar::add-line:vertical,
QScrollArea#scrollArea_inspectionInfo QScrollBar::sub-line:vertical,
QScrollArea#scrollArea_detectionSettings QScrollBar::add-line:vertical,
QScrollArea#scrollArea_detectionSettings QScrollBar::sub-line:vertical,
QScrollArea#scrollArea_imageSettings QScrollBar::add-line:vertical,
QScrollArea#scrollArea_imageSettings QScrollBar::sub-line:vertical,
QScrollArea#scrollArea_plcSettings QScrollBar::add-line:vertical,
QScrollArea#scrollArea_plcSettings QScrollBar::sub-line:vertical,
QScrollArea#scrollArea_softwareSettings QScrollBar::add-line:vertical,
QScrollArea#scrollArea_softwareSettings QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollArea#scrollArea_inspectionInfo QScrollBar::add-page:vertical,
QScrollArea#scrollArea_inspectionInfo QScrollBar::sub-page:vertical,
QScrollArea#scrollArea_detectionSettings QScrollBar::add-page:vertical,
QScrollArea#scrollArea_detectionSettings QScrollBar::sub-page:vertical,
QScrollArea#scrollArea_imageSettings QScrollBar::add-page:vertical,
QScrollArea#scrollArea_imageSettings QScrollBar::sub-page:vertical,
QScrollArea#scrollArea_plcSettings QScrollBar::add-page:vertical,
QScrollArea#scrollArea_plcSettings QScrollBar::sub-page:vertical,
QScrollArea#scrollArea_softwareSettings QScrollBar::add-page:vertical,
QScrollArea#scrollArea_softwareSettings QScrollBar::sub-page:vertical {
    background: transparent;
}

/* 12. 单控件例外 */
InspectionImageCanvas#inspectionImageCanvas {
    background-color: #202830;
    background-image: url(:/svg/canvas/canvas_background_grid.svg);
    background-repeat: repeat;
    border: 1px solid #111A22;
    border-right: none;
}

QLineEdit#lineEdit_totalCount,
QLineEdit#lineEdit_ngCount,
QLineEdit#lineEdit_detectionDuration,
QLineEdit#lineEdit_passRate {
    background-color: #FFFFFF;
    border: 1px solid #D0D9E0;
    font-size: 20px;
    font-weight: 600;
}

QLineEdit#lineEdit_totalCount {
    color: #17834C;
}

QLineEdit#lineEdit_ngCount {
    color: #C13F3F;
}

QLineEdit#lineEdit_detectionDuration {
    color: #1769AA;
}

QLineEdit#lineEdit_passRate {
    color: #000000;
}

QLineEdit#lineEdit_currentTemplateName {
    background-color: #FFFFFF;
    color: #000000;
    border: 1px solid #D0D9E0;
    font-size: 26px;
    font-weight: 600;
}

QCheckBox#checkBox_hardwareTriggerEnabled {
    border: 1px solid #B8C4CE;
    padding: 6px 12px;
    spacing: 10px;
    font-weight: 600;
}

QCheckBox#checkBox_hardwareTriggerEnabled:hover {
    background-color: #EAF3FA;
}

QCheckBox#checkBox_hardwareTriggerEnabled:disabled {
    background-color: #EDF1F4;
    color: #909DA8;
    border-color: #D4DDE5;
}

QCheckBox#checkBox_hardwareTriggerEnabled::indicator {
    width: 24px;
    height: 24px;
}
