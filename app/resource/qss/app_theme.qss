/* OCRGangYin 唯一正式工业视觉主题。 */

/* 1. 基础 */
QWidget {
    color: #000000;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
    font-size: 16px;
    font-weight: 400;
}

QWidget#MainWindow,
QDialog,
QMessageBox {
    background-color: #E9EEF3;
}

QWidget#widget_leftDrawer,
QWidget#widget_mainPanel {
    background-color: #EEF3F7;
    border: none;
}

QToolTip {
    background-color: #21303D;
    color: #FFFFFF;
    border: 1px solid #111A22;
    padding: 5px 8px;
    font-size: 16px;
    font-weight: 400;
}

/* 2. 容器、卡片和滚动区 */
QGroupBox {
    background-color: #F7F9FB;
    border: 1px solid #B8C4CE;
    margin-top: 18px;
    padding: 8px 6px 6px 6px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 7px;
    background-color: #F7F9FB;
    color: #000000;
    font-size: 16px;
    font-weight: 600;
}

QWidget#page_inspectionInfo,
QWidget#page_detectionSettings,
QWidget#page_imageSettings,
QWidget#page_plcSettings,
QWidget#page_softwareSettings {
    background: transparent;
    border: none;
}

QStackedWidget#stackedWidget_leftDrawer {
    background: transparent;
    border: 1px solid #B8C4CE;
}

QWidget#widget_leftDrawer QGroupBox {
    background-color: #F8FAFC;
}

QWidget#widget_leftDrawer QGroupBox::title {
    background-color: #EEF3F7;
}

QGroupBox#groupBox_currentTemplateSettings,
QGroupBox#groupBox_barcodeCsv,
QGroupBox#groupBox_detectionMode,
QGroupBox#groupBox_templateManagement,
QGroupBox#groupBox_imageSaving,
QGroupBox#groupBox_imageAcquisitionAndProcessing,
QGroupBox#groupBox_softwareData,
QGroupBox#groupBox_usageInstructions,
QGroupBox#groupBox_imageDisplay,
QGroupBox#groupBox_runtimeStatus,
QGroupBox#groupBox_productionStatistics,
QGroupBox#groupBox_totalCount,
QGroupBox#groupBox_ngCount,
QGroupBox#groupBox_detectionDuration,
QGroupBox#groupBox_passRate,
QGroupBox#groupBox_recognitionText,
QGroupBox#groupBox_currentTemplate,
QFrame#frame_plcTriggerMode,
QFrame#frame_plcConnection,
QFrame#frame_plcProcessParameters {
    background-color: #F8FAFC;
    border: 1px solid #B8C4CE;
    padding: 6px;
}

QGroupBox#groupBox_imageDisplay {
    margin-top: 0;
}

QWidget#widget_leftDrawer QGroupBox#groupBox_totalCount::title,
QWidget#widget_leftDrawer QGroupBox#groupBox_ngCount::title,
QWidget#widget_leftDrawer QGroupBox#groupBox_detectionDuration::title,
QWidget#widget_leftDrawer QGroupBox#groupBox_passRate::title {
    background-color: #F8FAFC;
}

QScrollArea#scrollArea_inspectionInfo,
QScrollArea#scrollArea_detectionSettings,
QScrollArea#scrollArea_imageSettings,
QScrollArea#scrollArea_plcSettings,
QScrollArea#scrollArea_softwareSettings {
    background: transparent;
    border: none;
}

QWidget#scrollAreaWidgetContents_inspectionInfo,
QWidget#widget_detectionSettingsScrollContent,
QWidget#widget_imageSettingsScrollContent,
QWidget#widget_plcSettingsScrollContent,
QWidget#widget_softwareSettingsScrollContent {
    background: transparent;
}

/* 3. 标签 */
QLabel {
    background: transparent;
    color: #000000;
}

QLabel:disabled {
    color: #909DA8;
}

QLabel#label_licenseExpiry,
QLabel#label_licenseExpiryValue {
    font-weight: 600;
}

QDialog#ActivationDialog QLabel,
QDialog#ActivationDialog QLineEdit,
QDialog#ActivationDialog QPushButton {
    font-weight: 600;
}

QDialog#ActivationDialog QLabel#label_status {
    color: #C13F3F;
}

QLabel#label_plcConnectionSection,
QLabel#label_plcProcessParametersSection,
QLabel#label_characterSampleTitle,
QLabel#label_currentEditTemplate {
    font-weight: 600;
}

QLabel#label_characterDrawHintTitle,
QLabel#label_characterExistingTitle,
QLabel#label_characterNameHintTitle,
QLabel#label_currentCharacterTemplate {
    font-size: 18px;
    font-weight: 600;
}

QLineEdit#lineEdit_currentCharacterTemplate {
    background: transparent;
    border: none;
    padding: 0;
    font-size: 18px;
    font-weight: 600;
}

QLabel#label_characterManualAction,
QLabel#label_characterAutoSplitAction {
    font-size: 16px;
    font-weight: 600;
}

QLabel#label_characterManualDescription,
QLabel#label_characterAutoSplitDescription,
QLabel#label_characterPreviewHint,
QLabel#label_characterNameHint {
    font-size: 16px;
    font-weight: 400;
}

QLabel#label_recognitionText {
    background: transparent;
    color: #1769AA;
    border: none;
    padding: 8px 10px;
    font-size: 20px;
    font-weight: 600;
}

QLabel#label_characterNameError {
    color: #C13F3F;
}

QLabel#label_characterPreviewEmpty {
    color: #909DA8;
}

QLabel#label_characterCropCanvas {
    background-color: #202830;
    border: 1px solid #B8C4CE;
}

QLabel#label_characterSample,
QLabel#label_characterPreviewImage {
    background-color: #FFFFFF;
    border: 1px solid #B8C4CE;
}

QToolButton#toolButton_deleteCharacterBox {
    background-color: transparent;
    border: none;
    padding: 0;
}

QToolButton#toolButton_deleteCharacterBox:hover {
    background-color: #B8D8F0;
}

QToolButton#toolButton_deleteCharacterBox:pressed {
    background-color: #7FAFD3;
}

QFrame#frame_templateGuide,
QFrame#frame_templateGuide QLabel {
    background: transparent;
    border: none;
    padding: 0;
}

QLabel#label_templateGuideTitle {
    color: #1769AA;
    font-size: 18px;
    font-weight: 600;
}

QLabel#label_templateGuideBody {
    color: #000000;
    font-size: 18px;
    font-weight: 400;
    qproperty-wordWrap: true;
}

/* 4. 普通按钮 */
QPushButton {
    min-height: 38px;
    background-color: #FFFFFF;
    color: #000000;
    border: 1px solid #B8C4CE;
    padding: 5px 12px;
    font-size: 16px;
    font-weight: 600;
}

QPushButton:focus {
    background-color: #F4F9FD;
    border-color: #1769AA;
}

QPushButton:hover {
    background-color: #F4F9FD;
    border-color: #6D9EC4;
}

QPushButton:pressed {
    background-color: #E2EDF5;
    border-color: #0E568E;
}

QPushButton:disabled {
    background-color: #EDF1F4;
    color: #909DA8;
    border-color: #D4DDE5;
}

/* 5. 主控工具栏与工具按钮 */
QFrame#frame_mainToolbar {
    background-color: #F8FAFC;
    border: 1px solid #B8C4CE;
}

QToolButton#toolButton_cameraAction,
QToolButton#toolButton_inspectionAction,
QToolButton#toolButton_previewAction {
    background-color: #FFFFFF;
    color: #000000;
    border: 1px solid #B8C4CE;
    padding: 2px;
    font-size: 16px;
    font-weight: 600;
}

QToolButton#toolButton_cameraAction:hover,
QToolButton#toolButton_inspectionAction:hover,
QToolButton#toolButton_previewAction:hover {
    background-color: #F4F9FD;
    border-color: #6D9EC4;
}

QToolButton#toolButton_cameraAction:focus,
QToolButton#toolButton_inspectionAction:focus,
QToolButton#toolButton_previewAction:focus {
    background-color: #F4F9FD;
    border-color: #1769AA;
}

QToolButton#toolButton_cameraAction:pressed,
QToolButton#toolButton_inspectionAction:pressed,
QToolButton#toolButton_previewAction:pressed {
    background-color: #E2EDF5;
    border-color: #0E568E;
}

QToolButton#toolButton_cameraAction:disabled,
QToolButton#toolButton_inspectionAction:disabled,
QToolButton#toolButton_previewAction:disabled {
    background-color: #EDF1F4;
    color: #909DA8;
    border-color: #D4DDE5;
}

QGroupBox#groupBox_templateManagement QPushButton {
    min-height: 45px;
    padding: 4px 10px;
    font-size: 16px;
    font-weight: 600;
    text-align: center;
}

QGroupBox#groupBox_templateManagement QPushButton#pushButton_createTemplate {
    background-color: #1769AA;
    color: #FFFFFF;
    border: 1px solid #1769AA;
}

QGroupBox#groupBox_templateManagement QPushButton#pushButton_createTemplate:hover {
    background-color: #247CB9;
    border-color: #247CB9;
}

QGroupBox#groupBox_templateManagement QPushButton#pushButton_createTemplate:pressed {
    background-color: #0E568E;
    border-color: #0E568E;
}

QGroupBox#groupBox_templateManagement QPushButton#pushButton_createTemplate:focus {
    background-color: #1769AA;
    border-color: #0E568E;
}

QGroupBox#groupBox_templateManagement QPushButton#pushButton_createTemplate:disabled {
    background-color: #A8C7DE;
    color: #FFFFFF;
    border-color: #A8C7DE;
}

QGroupBox#groupBox_templateManagement QPushButton#pushButton_editCharacterTemplates {
    background-color: transparent;
    color: #000000;
    border: 1px solid transparent;
}

QGroupBox#groupBox_templateManagement QPushButton#pushButton_editCharacterTemplates:hover {
    background-color: #F4F9FD;
    border-color: #6D9EC4;
}

QGroupBox#groupBox_templateManagement QPushButton#pushButton_editCharacterTemplates:pressed {
    background-color: #E2EDF5;
    border-color: transparent;
}

QGroupBox#groupBox_templateManagement QPushButton#pushButton_editCharacterTemplates:disabled {
    background-color: transparent;
    color: #909DA8;
    border-color: transparent;
}

QGroupBox#groupBox_templateManagement QPushButton#pushButton_exitTemplate {
    background-color: transparent;
    color: #C13F3F;
    border: 1px solid transparent;
}

QGroupBox#groupBox_templateManagement QPushButton#pushButton_exitTemplate:hover {
    background-color: #FFF1F1;
    border-color: #D9B4B4;
}

QGroupBox#groupBox_templateManagement QPushButton#pushButton_exitTemplate:pressed {
    background-color: #F8DDDD;
    border-color: transparent;
}

QGroupBox#groupBox_templateManagement QPushButton#pushButton_exitTemplate:disabled {
    background-color: transparent;
    color: #909DA8;
    border-color: transparent;
}

QFrame#line_templateManagementSeparator {
    min-height: 1px;
    max-height: 1px;
    background-color: #D4DDE5;
    border: none;
}

QFrame#frame_cameraStatus,
QFrame#frame_plcStatus,
QFrame#frame_hardwareTrigger {
    background-color: transparent;
    border: none;
}

QLabel#label_cameraStatusText,
QLabel#label_plcStatusText {
    background-color: transparent;
    border: none;
    color: #000000;
    font-size: 16px;
    font-weight: 400;
}

QLabel#label_hardwareTriggerTitle {
    color: #000000;
    font-size: 16px;
    font-weight: 600;
}

QFrame#frame_cameraStatusDot[connectionState="connected"],
QFrame#frame_plcStatusDot[connectionState="connected"] {
    background-color: #17834C;
    border: none;
    border-radius: 5px;
}

QFrame#frame_cameraStatusDot[connectionState="disconnected"],
QFrame#frame_plcStatusDot[connectionState="disconnected"] {
    background-color: #C13F3F;
    border: none;
    border-radius: 5px;
}

QWidget#widget_leftNavigationRail {
    background-color: #DBE3EA;
    border-top: 1px solid #BDC9D3;
    border-right: 1px solid #BDC9D3;
    border-bottom: 1px solid #BDC9D3;
}

QWidget#widget_leftNavigationRail QToolButton {
    background-color: transparent;
    color: #000000;
    border: none;
    padding: 5px 2px;
    font-size: 16px;
    font-weight: 600;
}

QWidget#widget_leftNavigationRail QToolButton:hover {
    background-color: #EAF1F6;
    color: #1769AA;
}

QWidget#widget_leftNavigationRail QToolButton:checked {
    background-color: #F8FAFC;
    color: #1769AA;
}

QSplitter#splitter_leftDrawerMain::handle:horizontal {
    background-color: #EEF3F7;
    border: none;
}

QSplitter#splitter_leftDrawerMain::handle:horizontal:hover {
    background-color: #B8C4CE;
}

/* 6. 输入控件 */
QLineEdit,
QTextEdit,
QPlainTextEdit,
QSpinBox,
QDoubleSpinBox,
QDateEdit,
QTimeEdit,
QComboBox {
    min-height: 38px;
    background-color: #FFFFFF;
    color: #000000;
    border: 1px solid #B8C4CE;
    padding: 5px 10px;
    font-size: 16px;
    selection-background-color: #1769AA;
    selection-color: #FFFFFF;
}

QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QDateEdit:hover,
QTimeEdit:hover,
QComboBox:hover {
    border-color: #8EA4B5;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateEdit:focus,
QTimeEdit:focus,
QComboBox:focus {
    background-color: #F4F9FD;
    border-color: #1769AA;
}

QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QDateEdit:disabled,
QTimeEdit:disabled,
QComboBox:disabled {
    background-color: #EDF1F4;
    color: #909DA8;
    border-color: #D4DDE5;
}

QTextEdit#textEdit_targetText {
    font-size: 26px;
    font-weight: 600;
}

QLineEdit[readOnly="true"],
QTextEdit[readOnly="true"],
QPlainTextEdit[readOnly="true"] {
    background-color: #F3F6F8;
    color: #000000;
}

QLineEdit[hasError="true"],
QTextEdit[hasError="true"],
QSpinBox[hasError="true"],
QDoubleSpinBox[hasError="true"] {
    background-color: #FFF1F1;
    border-color: #C13F3F;
}

QComboBox::drop-down {
    width: 28px;
    background-color: transparent;
    border: none;
    border-left: 1px solid #D4DDE5;
}

QComboBox::drop-down:disabled {
    background-color: #E5EAEE;
}

/* 7. 复选框 */
QCheckBox {
    background: transparent;
    color: #000000;
    spacing: 8px;
}

QCheckBox:hover {
    color: #1769AA;
}

QCheckBox:disabled {
    color: #909DA8;
}

QCheckBox::indicator {
    width: 20px;
    height: 20px;
}

/* 8. 列表、树、表格和弹出视图 */
QAbstractItemView {
    background-color: #FFFFFF;
    alternate-background-color: #F7F9FB;
    color: #000000;
    border: 1px solid #B8C4CE;
    selection-background-color: #1769AA;
    selection-color: #FFFFFF;
}

QHeaderView::section {
    background-color: #EEF3F7;
    color: #000000;
    border: none;
    border-right: 1px solid #D4DDE5;
    border-bottom: 1px solid #D4DDE5;
    padding: 6px 8px;
    font-weight: 600;
}

/* 9. 语义角色 */
QPushButton[uiRole="primary"] {
    background-color: #1769AA;
    color: #FFFFFF;
    border-color: #1769AA;
}

QPushButton[uiRole="primary"]:focus {
    background-color: #1769AA;
    border-color: #0E568E;
}

QPushButton[uiRole="primary"]:hover {
    background-color: #247CB9;
    border-color: #247CB9;
}

QPushButton[uiRole="primary"]:pressed {
    background-color: #0E568E;
    border-color: #0E568E;
}

QPushButton[uiRole="primary"]:disabled {
    background-color: #A8C7DE;
    color: #FFFFFF;
    border-color: #A8C7DE;
}

QPushButton[uiRole="danger"],
QPushButton#pushButton_clearSoftwareData,
QPushButton#pushButton_resetTotalCount,
QPushButton#pushButton_resetNgCount,
QPushButton#pushButton_resetRejectQueue {
    background-color: #C13F3F;
    color: #FFFFFF;
    border-color: #A93636;
}

QPushButton[uiRole="danger"]:hover,
QPushButton#pushButton_clearSoftwareData:hover,
QPushButton#pushButton_resetTotalCount:hover,
QPushButton#pushButton_resetNgCount:hover,
QPushButton#pushButton_resetRejectQueue:hover {
    background-color: #D14B4B;
    border-color: #B73838;
}

QPushButton[uiRole="danger"]:pressed,
QPushButton#pushButton_clearSoftwareData:pressed,
QPushButton#pushButton_resetTotalCount:pressed,
QPushButton#pushButton_resetNgCount:pressed,
QPushButton#pushButton_resetRejectQueue:pressed {
    background-color: #A93232;
    border-color: #8F2929;
}

QPushButton[uiRole="danger"]:disabled,
QPushButton#pushButton_clearSoftwareData:disabled,
QPushButton#pushButton_resetTotalCount:disabled,
QPushButton#pushButton_resetNgCount:disabled,
QPushButton#pushButton_resetRejectQueue:disabled {
    background-color: #D9B4B4;
    color: #FFFFFF;
    border-color: #D9B4B4;
}

/* 10. 运行状态与判定 */
QLabel#label_runtimeStatus {
    background-color: transparent;
    color: #000000;
    border: none;
    padding: 10px;
    font-size: 26px;
    font-weight: 600;
}

QLabel#label_runtimeStatus[uiState="idle"] {
    color: #000000;
}

QLabel#label_runtimeStatus[uiState="ready"] {
    color: #17834C;
}

QLabel#label_runtimeStatus[uiState="running"] {
    color: #1769AA;
}

QLabel#label_runtimeStatus[uiState="stopping"],
QLabel#label_runtimeStatus[uiState="warning"] {
    color: #C98218;
}

QLabel#label_verdictResult {
    background-color: #202830;
    border: 1px solid #111A22;
    border-left: none;
}

/* 11. 页面滚动条，仅限定左侧五页 */
QScrollArea#scrollArea_inspectionInfo QScrollBar:vertical,
QScrollArea#scrollArea_detectionSettings QScrollBar:vertical,
QScrollArea#scrollArea_imageSettings QScrollBar:vertical,
QScrollArea#scrollArea_plcSettings QScrollBar:vertical,
QScrollArea#scrollArea_softwareSettings QScrollBar:vertical {
    width: 8px;
    background: transparent;
    margin: 0;
}

QScrollArea#scrollArea_inspectionInfo QScrollBar::handle:vertical,
QScrollArea#scrollArea_detectionSettings QScrollBar::handle:vertical,
QScrollArea#scrollArea_imageSettings QScrollBar::handle:vertical,
QScrollArea#scrollArea_plcSettings QScrollBar::handle:vertical,
QScrollArea#scrollArea_softwareSettings QScrollBar::handle:vertical {
    min-height: 28px;
    background-color: #B9C6D1;
}

QScrollArea#scrollArea_inspectionInfo QScrollBar::handle:vertical:hover,
QScrollArea#scrollArea_detectionSettings QScrollBar::handle:vertical:hover,
QScrollArea#scrollArea_imageSettings QScrollBar::handle:vertical:hover,
QScrollArea#scrollArea_plcSettings QScrollBar::handle:vertical:hover,
QScrollArea#scrollArea_softwareSettings QScrollBar::handle:vertical:hover {
    background-color: #8EA4B5;
}

QScrollArea#scrollArea_inspectionInfo QScrollBar::add-line:vertical,
QScrollArea#scrollArea_inspectionInfo QScrollBar::sub-line:vertical,
QScrollArea#scrollArea_detectionSettings QScrollBar::add-line:vertical,
QScrollArea#scrollArea_detectionSettings QScrollBar::sub-line:vertical,
QScrollArea#scrollArea_imageSettings QScrollBar::add-line:vertical,
QScrollArea#scrollArea_imageSettings QScrollBar::sub-line:vertical,
QScrollArea#scrollArea_plcSettings QScrollBar::add-line:vertical,
QScrollArea#scrollArea_plcSettings QScrollBar::sub-line:vertical,
QScrollArea#scrollArea_softwareSettings QScrollBar::add-line:vertical,
QScrollArea#scrollArea_softwareSettings QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollArea#scrollArea_inspectionInfo QScrollBar::add-page:vertical,
QScrollArea#scrollArea_inspectionInfo QScrollBar::sub-page:vertical,
QScrollArea#scrollArea_detectionSettings QScrollBar::add-page:vertical,
QScrollArea#scrollArea_detectionSettings QScrollBar::sub-page:vertical,
QScrollArea#scrollArea_imageSettings QScrollBar::add-page:vertical,
QScrollArea#scrollArea_imageSettings QScrollBar::sub-page:vertical,
QScrollArea#scrollArea_plcSettings QScrollBar::add-page:vertical,
QScrollArea#scrollArea_plcSettings QScrollBar::sub-page:vertical,
QScrollArea#scrollArea_softwareSettings QScrollBar::add-page:vertical,
QScrollArea#scrollArea_softwareSettings QScrollBar::sub-page:vertical {
    background: transparent;
}

/* 12. 单控件例外 */
InspectionImageCanvas#inspectionImageCanvas {
    background-color: #202830;
    background-image: url(:/svg/canvas/canvas_background_grid.svg);
    background-repeat: repeat;
    border: 1px solid #111A22;
    border-right: none;
}

QLineEdit#lineEdit_totalCount,
QLineEdit#lineEdit_ngCount,
QLineEdit#lineEdit_detectionDuration,
QLineEdit#lineEdit_passRate {
    background-color: transparent;
    border: none;
    font-weight: 600;
}

QLineEdit#lineEdit_totalCount,
QLineEdit#lineEdit_ngCount {
    font-size: 16px;
}

QLineEdit#lineEdit_detectionDuration,
QLineEdit#lineEdit_passRate {
    font-size: 20px;
}

QLineEdit#lineEdit_totalCount {
    color: #17834C;
}

QLineEdit#lineEdit_ngCount {
    color: #C13F3F;
}

QLineEdit#lineEdit_detectionDuration {
    color: #1769AA;
}

QLineEdit#lineEdit_passRate {
    color: #000000;
}

QLineEdit#lineEdit_currentTemplateName {
    background-color: #FFFFFF;
    color: #000000;
    border: none;
    font-size: 26px;
    font-weight: 600;
}

QCheckBox#checkBox_hardwareTriggerEnabled {
    spacing: 5px;
    font-size: 16px;
    font-weight: 400;
}

QCheckBox#checkBox_hardwareTriggerEnabled::indicator {
    width: 30px;
    height: 16px;
    border: none;
}

QCheckBox#checkBox_hardwareTriggerEnabled::indicator:unchecked {
    image: url(:/svg/toggle_off.svg);
}

QCheckBox#checkBox_hardwareTriggerEnabled::indicator:checked {
    image: url(:/svg/toggle_on.svg);
}
