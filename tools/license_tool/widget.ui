}
QLabel#expiresLabel, QLabel#featuresLabel, QLabel#defaultModeLabel,
QLabel#deviceBindingLabel, QLabel#outputLabel, QLabel#datLabel,
QLabel#licenseInfoLabel { color: #606266; font-weight: 600; }

QLineEdit, QDateEdit, QComboBox, QListWidget, QTextEdit {
    min-height: 36px;
    background-color: #ffffff;
    color: #303133;
    border: 1px solid #dcdfe6;
    border-radius: 5px;
    padding: 5px 10px;
    selection-background-color: #409eff;
    selection-color: #ffffff;
}
QLineEdit:focus, QDateEdit:focus, QComboBox:focus,
QListWidget:focus, QTextEdit:focus { border-color: #409eff; }
QLineEdit:read-only, QTextEdit:read-only { background-color: #fbfbfc; }

QPushButton {
    min-height: 36px;
    background-color: #ffffff;
    color: #303133;
    border: 1px solid #dcdfe6;
    border-radius: 5px;
    padding: 0 16px;
    font-weight: 600;
}
QPushButton:hover { background-color: #ecf5ff; border-color: #409eff; color: #1677d2; }
QPushButton:pressed { background-color: #d9ecff; border-color: #1677d2; }
QPushButton#generateButton, QPushButton#readDatButton {
    background-color: #1677d2; color: #ffffff; border-color: #1677d2;
}
QPushButton#generateButton:hover, QPushButton#readDatButton:hover {
    background-color: #409eff; color: #ffffff; border-color: #409eff;
}
QPushButton#generateButton:pressed, QPushButton#readDatButton:pressed {
    background-color: #0f5fae; border-color: #0f5fae;
}
QLabel#statusLabel {
    color: #1677d2; background-color: #f0f7ff; border: 1px solid #d9ecff;
    border-radius: 5px; padding: 9px 12px;
}
QFrame#line { color: #e4e7ed; }</string>
