}

QLabel { background: transparent; }
QLabel#titleLabel { color: #1f2d3d; font-size: 24px; font-weight: 700; }
QLabel#subtitleLabel { color: #909399; font-size: 13px; }
QLabel#generateSectionLabel, QLabel#readSectionLabel {
