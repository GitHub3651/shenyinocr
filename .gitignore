# Build, deployment and archival directories
**/build/
/build-*/
/dist/
/archive/
**/output/

# Transitional former worktree. It is removed after .git moves to the root.
/Autoadd/

# Binary third-party packages are supplied outside Git. Keep only the
# reproducible dependency manifest under version control.
/third_party/*
!/third_party/
!/third_party/DEPENDENCIES.md

# Qt / QMake generated files and user-specific Qt Creator settings
/.qmake.stash
/.qmake.cache
Makefile
Makefile.*
object_script.*
*_plugin_import.cpp
*.pro.user
*.pro.user.*
moc_*.cpp
moc_*.h
ui_*.h
qrc_*.cpp

# CMake and IDE build metadata
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.suo
*.user
*.ipch
*.pch
*.aps
*.ncb
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
/.vs/
/.vscode/

# Tool build output
/tools/barcode_decoder/build*/
/tools/barcode_decoder/debug/
/tools/barcode_decoder/release/
/tools/license_tool/debug/
/tools/license_tool/release/

# Python experiment environments, inputs and generated output
/experiments/industrial_char_segmenter/.venv/
/experiments/industrial_char_segmenter/venv/
/experiments/industrial_char_segmenter/__pycache__/
/experiments/industrial_char_segmenter/data/input/
/experiments/industrial_char_segmenter/data/output/
**/__pycache__/
*.py[cod]

# Runtime and compiler artifacts. Source code, .ui, .qrc, Qt projects,
# PaddleOCR source, tool source and documents remain tracked.
*.obj
*.o
*.exe
*.dll
*.so
*.a
*.lib
*.pdb
*.ilk
*.exp
*.qm
*.log
*.bak
*.autosave
Thumbs.db
.DS_Store

# Local models and run-time data are deployed separately.
models/
Model/
myImage/

# Existing application translations are retained during the layout migration.
!app/Translate_CN.qm
!app/Translate_EN.qm
